# Copy to /srv/homestack/nexus/compose.env and edit for the Debian VM.
# These shell-compatible values are also used by deploy/update-game.sh.
NEXUS_HOME=/srv/homestack/nexus
# Replace this example with the VM's reserved/static LAN IPv4 address.
NEXUS_BIND_IP=192.168.10.210
NEXUS_PORT=8400
# Use a unique local tag per Nexus release; keep the previous image for rollback.
NEXUS_IMAGE=tabletop-nexus:vm-initial
